  <style>
    /* Estilos complementares perfeitamente integrados ao design system da Wevitria */
    .proof-strip {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-top: 36px;
      padding-top: 28px;
      border-top: 1px solid rgba(6, 109, 224, 0.18);
    }
    .proof-cell {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .proof-num {
      font-size: 1.55rem;
      font-weight: 850;
      color: var(--blue);
      letter-spacing: -0.04em;
      line-height: 1.1;
    }
    .proof-lbl {
      font-size: 0.72rem;
      font-weight: 750;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      line-height: 1.35;
    }

    /* Histórico & Escopo em Quem Somos */
    .history-block {
      margin-top: 48px;
      padding-top: 40px;
      border-top: 1px solid var(--line);
    }
    .history-heading {
      margin-bottom: 24px;
    }
    .history-heading h3 {
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--navy);
      letter-spacing: -0.03em;
    }
    .history-heading p {
      font-size: 0.94rem;
      color: var(--muted);
      margin-top: 6px;
    }
    .history-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }
    .history-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 22px 24px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .history-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(6, 37, 95, 0.08);
      border-color: #bad8fc;
    }
    .history-tag {
      font-size: 0.68rem;
      font-weight: 850;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--blue);
    }
    .history-card h4 {
      font-size: 1.05rem;
      font-weight: 750;
      color: var(--navy);
      line-height: 1.25;
    }
    .history-card p {
      font-size: 0.86rem;
      color: #53688e;
      line-height: 1.6;
    }

    /* Cases & Portfólio de Peso */
    .cases-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
    .case-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 20px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      position: relative;
      overflow: hidden;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .case-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow);
      border-color: #abcffb;
    }
    .case-card::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--blue), var(--cyan));
    }
    .case-tag {
      font-size: 0.66rem;
      font-weight: 850;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--blue);
    }
    .case-card h3 {
      font-size: 1.06rem;
      font-weight: 800;
      color: var(--navy);
      line-height: 1.3;
    }
    .case-card p {
      font-size: 0.85rem;
      color: var(--muted);
      line-height: 1.55;
    }
    .case-badge {
      display: inline-flex;
      align-self: flex-start;
      margin-top: auto;
      padding: 5px 10px;
      border-radius: 999px;
      background: var(--soft);
      border: 1px solid #d9e8fb;
      font-size: 0.65rem;
      font-weight: 800;
      color: #174780;
    }

    @media (max-width: 900px) {
      .proof-strip {
        grid-template-columns: repeat(2, 1fr);
      }
      .history-grid {
        grid-template-columns: 1fr;
      }
      .cases-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 600px) {
      .proof-strip {
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }
      .cases-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
